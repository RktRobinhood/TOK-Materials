      "lines": [
        {
          "kind": "say",
          "actor": "schoolteacher",
          "text": "True. No. False. No. ONE. ZER—"
        },
        {
          "kind": "say",
          "actor": "sweep",
          "text": "That's my sentence! From her board! It WORKS!"
        },
        {
          "kind": "say",
          "actor": "narrator",
          "text": "Her mask slides off. Under it: a crowned imp. Her own tired eyes."
        },
        {
          "kind": "say",
          "actor": "narrator",
          "text": "Her black scarf falls. It never moved in the wind. It's my shadow."
        },
        {
          "kind": "say",
          "actor": "narrator",
          "text": "Round the tables, more masks drop. Imps in borrowed faces. Nudge's too."
        },
        {
          "kind": "say",
          "actor": "nudge",
          "text": "My mask! Forty villagers trusted that face! I COUNTED!"
        },
        {
          "kind": "say",
          "actor": "narrator",
          "text": "And out of Nudge's mask tumbles my first piece."
        },
        {
          "kind": "say",
          "actor": "schoolteacher",
          "text": "Forty years I marked \"maybe\" wrong. Red ink. Every child."
        },
        {
          "kind": "say",
          "actor": "schoolteacher",
          "text": "If \"maybe\" was allowed… I was cruel for forty years."
        },
        {
          "kind": "say",
          "actor": "schoolteacher",
          "text": "So when a voice offered me a world with no maybes… I said yes."
        },
        {
          "kind": "say",
          "actor": "granny",
          "text": "Not a drop on me. But leeks? In MY soup? Here, dear. My Spare Axiom."
        },
        {
          "kind": "say",
          "actor": "narrator",
          "text": "She steps up onto the window. The Sky Rift glows behind her."
        },
        {
          "kind": "say",
          "actor": "schoolteacher",
          "text": "Tomorrow is waiting. Everyone there has already decided about you."
        },
        {
          "kind": "say",
          "actor": "algorithm",
          "text": "\"SEE? SHE'S ON MY SIDE.\" SHE WAS. MY SIDE."
        },
        {
          "kind": "say",
          "actor": "algorithm",
          "text": "THE NEXT ERA WILL BE… probably— LOUDER."
        }
      ]
