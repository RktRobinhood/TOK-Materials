      "lines": [
        {
          "kind": "say",
          "actor": "sequins",
          "text": "Take my Lucky Sequin. Keep the apprentice for now. You're better company."
        },
        {
          "kind": "say",
          "actor": "nudge",
          "text": "My ring light! That was my whole FACE!"
        },
        {
          "kind": "say",
          "actor": "narrator",
          "text": "You caught my piece as it ran. Above us, the eye shrinks a little."
        },
        {
          "kind": "say",
          "actor": "algorithm",
          "text": "PREDICTED. YOU SAVED THE MAGPIE. I TOOK THE TORTOISE."
        },
        {
          "kind": "say",
          "actor": "algorithm",
          "text": "YOU ALWAYS KNOW THE ANSWER. I KNEW YOURS."
        }
      ]
