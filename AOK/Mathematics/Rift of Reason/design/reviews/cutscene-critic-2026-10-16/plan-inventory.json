      "lines": [
        {
          "kind": "say",
          "actor": "sequins",
          "text": "Make way! The final! Our finalist: Traveller! My apprentice will predict!"
        },
        {
          "kind": "say",
          "actor": "guess-o-matic",
          "text": "Probably wins."
        },
        {
          "kind": "say",
          "actor": "avatar-fox-girl",
          "text": "Probably? I'll win that trophy. I always know the answer."
        },
        {
          "kind": "say",
          "actor": "sequins",
          "text": "Always? How thrilling. How unlikely."
        },
        {
          "kind": "say",
          "actor": "speedcheeta",
          "text": "Chat! This kid said ALWAYS! Clip it! Clip it!"
        },
        {
          "kind": "say",
          "actor": "algorithm",
          "text": "QUOTE SAVED."
        },
        {
          "kind": "say",
          "actor": "sequins",
          "text": "The trophy! Still at my stall! Polished by me! Twice! Back in a—"
        },
        {
          "kind": "say",
          "actor": "granny",
          "text": "The hair on the sky. It's opening."
        },
        {
          "kind": "say",
          "actor": "granny",
          "text": "It has an eye. Made of little pictures. How rude."
        },
        {
          "kind": "say",
          "actor": "nudge",
          "text": "Got it, boss! Saved to favourites!"
        },
        {
          "kind": "say",
          "actor": "narrator",
          "text": "Hey! That was my shadow! I was using it!"
        },
        {
          "kind": "say",
          "actor": "algorithm",
          "text": "SHADOW SAVED TO FAVOURITES. THANK YOU FOR YOUR CONTENT."
        },
        {
          "kind": "say",
          "actor": "granny",
          "text": "The eye's light. It's inside that gull."
        },
        {
          "kind": "say",
          "actor": "siuuugull",
          "text": "I AM ALWAYS RIGHT! ALWAYS! SIUUU!"
        },
        {
          "kind": "say",
          "actor": "sequins",
          "text": "Forget the trophy!"
        },
        {
          "kind": "say",
          "actor": "sequins",
          "text": "My sequins! The crack is drinking them! Down the Road! WAIT FOR ME!"
        },
        {
          "kind": "say",
          "actor": "algorithm",
          "text": "PREDICTION: Traveller FOLLOWS THE CRACK. CONFIDENCE: 94%."
        },
        {
          "kind": "say",
          "actor": "avatar-fox-girl",
          "text": "Wrong. I decide where I go."
        }
      ]
